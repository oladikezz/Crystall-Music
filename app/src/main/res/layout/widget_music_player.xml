<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    android:gravity="center_vertical">

    <!-- Album Art -->
    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:scaleType="centerCrop"
        android:background="@drawable/widget_cover_bg"
        android:src="@drawable/ic_crystall_logo"
        android:contentDescription="Album Art" />

    <!-- Title and Artist -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crystall Music"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Включите музыку"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Transport Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_btn_prev"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_widget_prev"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:contentDescription="Previous" />

        <ImageView
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_widget_play"
            android:background="@drawable/widget_play_btn_bg"
            android:padding="8dp"
            android:contentDescription="Play or Pause" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_widget_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:contentDescription="Next" />
    </LinearLayout>

</LinearLayout>
